{
  "compilerOptions": {
    "target": "ES5",
    "module": "commonjs",
    "baseUrl": "./",
    "rootDir": "./",
    "typeRoots": ["./types"],
    "lib": ["DOM", "ES2019"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "typings"]
}
