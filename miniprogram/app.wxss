page {
  background-color: #f5f7fb;
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  color: #1a1a1a;
}

.section-card {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(26, 115, 232, 0.08);
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #0d47a1;
}

.section-subtitle {
  font-size: 28rpx;
  color: #546e7a;
  line-height: 1.6;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1a73e8;
  background: rgba(26, 115, 232, 0.12);
}

.tag-warning {
  color: #f57c00;
  background: rgba(245, 124, 0, 0.16);
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
  gap: 24rpx;
}

@media (min-width: 768px) {
  .card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.card {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e3f2fd;
}

.card + .card {
  margin-top: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #1a1a1a;
}

.card-body {
  font-size: 26rpx;
  line-height: 1.7;
  color: #455a64;
}

.list {
  margin-top: 16rpx;
}

.list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #37474f;
}

.list-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #1a73e8;
}

.list-dot.warning {
  background: #f57c00;
}

.table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 12rpx;
}

.table thead {
  background: #e3f2fd;
}

.table th,
.table td {
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  border-bottom: 1rpx solid #e0e0e0;
  vertical-align: top;
}

.badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 150, 136, 0.15);
  color: #00695c;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.picker-trigger {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #c5cae9;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #1a237e;
  background: rgba(197, 202, 233, 0.18);
}

.empty-hint {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #78909c;
}

blockquote {
  margin: 24rpx 0 0;
  padding: 24rpx;
  border-left: 8rpx solid #1a73e8;
  background: rgba(226, 239, 255, 0.6);
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
