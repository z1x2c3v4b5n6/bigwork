page {
  background-color: #f5f7fa;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(11, 107, 203, 0.08);
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0b6bcb;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 28rpx;
  color: #5f6b7c;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
  margin-top: 20rpx;
  margin-bottom: 12rpx;
}

.bullet {
  position: relative;
  padding-left: 28rpx;
  font-size: 26rpx;
  color: #3c4858;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.bullet::before {
  content: '';
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #0b6bcb;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background-color: rgba(11, 107, 203, 0.12);
  color: #0b6bcb;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.link {
  color: #0b6bcb;
  font-size: 26rpx;
  text-decoration: underline;
  word-break: break-all;
}
