<view class="page">
  <scroll-view class="scroll" scroll-y enable-flex="true">
    <view class="card" wx:for="{{materials}}" wx:key="id" wx:for-item="material">
      <view class="card-title">{{material.title}}</view>
      <view class="card-desc">{{material.major}}</view>

      <view class="section-title">复试高频考点</view>
      <view>
        <view class="tag" wx:for="{{material.focus}}" wx:key="index" wx:for-item="focus">{{focus}}</view>
      </view>

      <view class="section-title">备考安排</view>
      <view class="bullet" wx:for="{{material.preparation}}" wx:key="index" wx:for-item="plan">{{plan}}</view>

      <view class="section-title">推荐资料</view>
      <view class="bullet" wx:for="{{material.resources}}" wx:key="name" wx:for-item="resource">
        <text>{{resource.name}}：</text>
        <text class="link">{{resource.url}}</text>
      </view>
    </view>

    <view class="card" wx:for="{{majors}}" wx:key="major" wx:for-item="majorPlan">
      <view class="card-title">{{majorPlan.major}}复试规划</view>
      <view class="section-title">优势亮点</view>
      <view class="bullet" wx:for="{{majorPlan.strengths}}" wx:key="index" wx:for-item="strength">{{strength}}</view>

      <view class="section-title">面试关注点</view>
      <view class="bullet" wx:for="{{majorPlan.interviewFocus}}" wx:key="index" wx:for-item="focus">{{focus}}</view>

      <view class="section-title">外部参考</view>
      <view class="bullet" wx:for="{{majorPlan.references}}" wx:key="name" wx:for-item="reference">
        <text>{{reference.name}}：</text>
        <text class="link">{{reference.url}}</text>
      </view>
    </view>
  </scroll-view>
</view>
