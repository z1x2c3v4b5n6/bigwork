.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  background: #0f172a;
  color: #f8fafc;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.header__title {
  font-size: 40rpx;
  font-weight: 700;
}

.header__subtitle {
  font-size: 26rpx;
  color: rgba(148, 163, 184, 0.9);
}

.header__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(148, 163, 184, 0.85);
}

.header__sync {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #22d3ee, #38bdf8);
  color: #0f172a;
  font-size: 24rpx;
  border: none;
}

.message {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.message--success {
  background: rgba(34, 197, 94, 0.16);
  color: #bbf7d0;
}

.message--error {
  background: rgba(248, 113, 113, 0.12);
  color: #fecaca;
}

.toggle-btn {
  align-self: flex-start;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(56, 189, 248, 0.18);
  border: 1rpx solid rgba(125, 211, 252, 0.4);
  color: #f8fafc;
  font-size: 24rpx;
}

.form {
  background: rgba(30, 41, 59, 0.72);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form__field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form__label {
  font-size: 24rpx;
  color: rgba(148, 163, 184, 0.9);
}

.form__input {
  min-height: 120rpx;
  background: rgba(15, 23, 42, 0.72);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  color: #f8fafc;
  font-size: 26rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.3);
}

.form__input--note {
  min-height: 160rpx;
}

.form__submit {
  align-self: flex-end;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #a855f7, #6366f1);
  color: #f8fafc;
  border: none;
  font-size: 26rpx;
}

.empty {
  font-size: 26rpx;
  color: rgba(148, 163, 184, 0.8);
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(30, 41, 59, 0.6);
}

.list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  max-height: 800rpx;
}

.item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: rgba(30, 41, 59, 0.82);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.25);
}

.item--pending {
  border-color: rgba(249, 115, 22, 0.45);
  background: rgba(250, 204, 21, 0.1);
}

.item__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(148, 163, 184, 0.85);
  font-size: 24rpx;
}

.item__tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(14, 165, 233, 0.2);
  color: #bae6fd;
}

.item__question {
  font-size: 30rpx;
  font-weight: 600;
  color: #f8fafc;
}

.item__answer,
.item__analysis {
  font-size: 26rpx;
  color: rgba(226, 232, 240, 0.9);
  line-height: 1.6;
}

.item__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(148, 163, 184, 0.8);
}

.item__delete {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(248, 113, 113, 0.16);
  color: #fecaca;
  border: 1rpx solid rgba(248, 113, 113, 0.3);
}
