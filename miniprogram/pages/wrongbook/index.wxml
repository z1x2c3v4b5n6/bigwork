<view class="page">
  <view class="header">
    <view class="header__title">离线错题本</view>
    <view class="header__subtitle">题目与解析随时可查，离线也不怕丢失进度。</view>
    <view class="header__meta">
      <text>待同步 {{pendingCount}} 条</text>
      <button class="header__sync" loading="{{syncing}}" bindtap="handleManualSync">立即同步</button>
    </view>
  </view>

  <view class="message message--success" wx:if="{{successMessage}}">{{successMessage}}</view>
  <view class="message message--error" wx:if="{{errorMessage}}">{{errorMessage}}</view>

  <button class="toggle-btn" bindtap="toggleForm">{{formVisible ? '取消新增' : '新增错题'}}</button>

  <view class="form" wx:if="{{formVisible}}">
    <view class="form__field">
      <view class="form__label">题干</view>
      <textarea class="form__input" placeholder="请输入题目" value="{{form.question}}" data-field="question" bindinput="handleFormInput"></textarea>
    </view>
    <view class="form__field">
      <view class="form__label">参考答案</view>
      <textarea class="form__input" placeholder="请输入答案" value="{{form.answer}}" data-field="answer" bindinput="handleFormInput"></textarea>
    </view>
    <view class="form__field">
      <view class="form__label">错因记录</view>
      <textarea class="form__input form__input--note" placeholder="错误原因、重做心得…" value="{{form.analysis}}" data-field="analysis" bindinput="handleFormInput"></textarea>
    </view>
    <button class="form__submit" bindtap="submitForm">保存到错题本</button>
  </view>

  <view class="empty" wx:if="{{!items.length}}">暂无错题，快去刷题吧！</view>

  <scroll-view scroll-y="true" class="list" wx:if="{{items.length}}">
    <block wx:for="{{items}}" wx:key="id">
      <view class="item {{item.synced ? '' : 'item--pending'}}">
        <view class="item__header">
          <view class="item__tag">错题</view>
          <view class="item__time">更新于 {{item.displayTime}}</view>
        </view>
        <view class="item__question">{{item.question}}</view>
        <view class="item__answer">参考答案：{{item.answer}}</view>
        <view class="item__analysis" wx:if="{{item.analysis}}">反思：{{item.analysis}}</view>
        <view class="item__actions">
          <text class="item__status">{{item.synced ? '已同步' : '待同步'}}</text>
          <button class="item__delete" size="mini" data-id="{{item.id}}" bindtap="removeEntry">删除</button>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
