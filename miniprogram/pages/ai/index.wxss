.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f172a, #111827 60%, #1e293b 100%);
  color: #f8fafc;
  padding: 32rpx 24rpx 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero {
  background: rgba(30, 41, 59, 0.7);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border: 1rpx solid rgba(56, 189, 248, 0.2);
}

.hero__title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero__subtitle {
  font-size: 26rpx;
  color: rgba(148, 163, 184, 0.9);
}

.message {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.message--error {
  background: rgba(248, 113, 113, 0.12);
  color: #fecaca;
}

.message--info {
  background: rgba(59, 130, 246, 0.16);
  color: #bfdbfe;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: rgba(15, 23, 42, 0.6);
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(59, 130, 246, 0.15);
}

.section__header {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section__title {
  font-size: 30rpx;
  font-weight: 600;
}

.section__subtitle {
  font-size: 24rpx;
  color: rgba(148, 163, 184, 0.8);
}

.suggestion-grid {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(auto-fit, minmax(260rpx, 1fr));
}

.suggestion-card {
  background: rgba(30, 41, 59, 0.78);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(56, 189, 248, 0.25);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.suggestion-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e0f2fe;
}

.suggestion-card__description {
  font-size: 24rpx;
  color: rgba(191, 219, 254, 0.85);
  line-height: 1.6;
}

.suggestion-card__action {
  align-self: flex-start;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  background: rgba(59, 130, 246, 0.28);
  color: #dbeafe;
  border: 1rpx solid rgba(37, 99, 235, 0.3);
  font-size: 22rpx;
}

.recommendation-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recommendation-group__title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(191, 219, 254, 0.95);
}

.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recommendation-item {
  background: rgba(30, 41, 59, 0.78);
  border-radius: 24rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(59, 130, 246, 0.18);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.recommendation-item__title {
  font-size: 26rpx;
  font-weight: 600;
}

.recommendation-item__meta {
  font-size: 22rpx;
  color: rgba(148, 163, 184, 0.85);
}

.recommendation-item__description {
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.88);
  line-height: 1.6;
}

.recommendation-item__link {
  align-self: flex-start;
  border-radius: 16rpx;
  background: rgba(59, 130, 246, 0.2);
  color: #dbeafe;
  border: 1rpx solid rgba(37, 99, 235, 0.3);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  background: rgba(30, 41, 59, 0.72);
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.25);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-item__question {
  font-size: 26rpx;
  color: #e2e8f0;
}

.history-item__meta {
  font-size: 22rpx;
  color: rgba(148, 163, 184, 0.7);
}

.conversation {
  flex: 1;
  max-height: 900rpx;
  background: rgba(15, 23, 42, 0.72);
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  border: 1rpx solid rgba(30, 64, 175, 0.3);
}

.bubble {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(30, 41, 59, 0.86);
  box-shadow: 0 24rpx 48rpx rgba(15, 23, 42, 0.3);
}

.bubble--user {
  border: 1rpx solid rgba(129, 140, 248, 0.35);
  align-self: flex-end;
  background: linear-gradient(135deg, rgba(129, 140, 248, 0.22), rgba(59, 130, 246, 0.22));
}

.bubble--assistant {
  border: 1rpx solid rgba(56, 189, 248, 0.35);
  align-self: flex-start;
}

.bubble__role {
  font-size: 22rpx;
  color: rgba(148, 163, 184, 0.8);
}

.bubble__content {
  font-size: 28rpx;
  line-height: 1.7;
  color: #f8fafc;
  white-space: pre-wrap;
}

.bubble__resend {
  align-self: flex-end;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(59, 130, 246, 0.24);
  color: #bfdbfe;
  border: 1rpx solid rgba(59, 130, 246, 0.3);
  font-size: 22rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: rgba(15, 23, 42, 0.95);
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.composer__input {
  flex: 1;
  min-height: 120rpx;
  max-height: 280rpx;
  background: rgba(30, 41, 59, 0.9);
  border-radius: 24rpx;
  padding: 20rpx;
  color: #f8fafc;
  border: 1rpx solid rgba(59, 130, 246, 0.35);
  font-size: 26rpx;
}

.composer__send {
  min-width: 160rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #38bdf8, #22d3ee);
  color: #0f172a;
  border: none;
  font-weight: 600;
}
