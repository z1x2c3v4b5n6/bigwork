.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f172a, #111827 60%, #1e293b 100%);
  color: #f8fafc;
  padding: 32rpx 24rpx 200rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero {
  background: rgba(30, 41, 59, 0.7);
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border: 1rpx solid rgba(56, 189, 248, 0.2);
}

.hero__title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero__subtitle {
  font-size: 26rpx;
  color: rgba(148, 163, 184, 0.9);
}

.message {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.message--error {
  background: rgba(248, 113, 113, 0.12);
  color: #fecaca;
}

.conversation {
  flex: 1;
  max-height: 900rpx;
  background: rgba(15, 23, 42, 0.72);
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  border: 1rpx solid rgba(30, 64, 175, 0.3);
}

.bubble {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(30, 41, 59, 0.86);
  box-shadow: 0 24rpx 48rpx rgba(15, 23, 42, 0.3);
}

.bubble--user {
  border: 1rpx solid rgba(129, 140, 248, 0.35);
  align-self: flex-end;
  background: linear-gradient(135deg, rgba(129, 140, 248, 0.22), rgba(59, 130, 246, 0.22));
}

.bubble--assistant {
  border: 1rpx solid rgba(56, 189, 248, 0.35);
  align-self: flex-start;
}

.bubble__role {
  font-size: 22rpx;
  color: rgba(148, 163, 184, 0.8);
}

.bubble__content {
  font-size: 28rpx;
  line-height: 1.7;
  color: #f8fafc;
  white-space: pre-wrap;
}

.bubble__resend {
  align-self: flex-end;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(59, 130, 246, 0.24);
  color: #bfdbfe;
  border: 1rpx solid rgba(59, 130, 246, 0.3);
  font-size: 22rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: rgba(15, 23, 42, 0.95);
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.composer__input {
  flex: 1;
  min-height: 120rpx;
  max-height: 280rpx;
  background: rgba(30, 41, 59, 0.9);
  border-radius: 24rpx;
  padding: 20rpx;
  color: #f8fafc;
  border: 1rpx solid rgba(59, 130, 246, 0.35);
  font-size: 26rpx;
}

.composer__send {
  min-width: 160rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #38bdf8, #22d3ee);
  color: #0f172a;
  border: none;
  font-weight: 600;
}
