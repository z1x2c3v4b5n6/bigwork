.page {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  background: #f4f6fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.section {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section--login {
  gap: 32rpx;
}

.section__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0b1f33;
}

.section__subtitle {
  font-size: 26rpx;
  color: #4d5b73;
  line-height: 1.5;
}

.section__meta {
  font-size: 24rpx;
  color: #94a3b8;
}

.section__meta {
  font-size: 24rpx;
  color: #94a3b8;
}

.role-chip {
  align-self: flex-start;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(11, 107, 203, 0.12);
  color: #0b6bcb;
  font-size: 24rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  text-align: center;
}

.login-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.login-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0f172a;
}

.login-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.demo-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: rgba(59, 130, 246, 0.06);
  border: 1rpx dashed rgba(59, 130, 246, 0.32);
  border-radius: 24rpx;
  padding: 24rpx;
}

.demo-section__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d4ed8;
}

.demo-section__desc {
  font-size: 24rpx;
  color: #4562a5;
  line-height: 1.5;
}

.demo-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.demo-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.5);
  background: #ffffff;
  padding: 24rpx;
  transition: all 0.2s ease;
}

.demo-card--hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.12);
}

.demo-card--active {
  border-color: #1d4ed8;
  box-shadow: 0 12rpx 30rpx rgba(59, 130, 246, 0.22);
}

.demo-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.demo-card__meta {
  font-size: 24rpx;
  color: #475569;
  margin-top: 6rpx;
}

.demo-card__desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.demo-card__action {
  align-self: flex-start;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(59, 130, 246, 0.12);
  color: #1d4ed8;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: #e2e8f0;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form--login {
  gap: 24rpx;
}

.form__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.form__register {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #475569;
}

.form__register-text {
  color: #475569;
}

.input,
.textarea,
.picker {
  width: 100%;
  padding: 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid #d8e2f2;
  box-sizing: border-box;
  font-size: 26rpx;
  background: #f8fbff;
}

.textarea {
  min-height: 180rpx;
}

.button {
  width: 100%;
  border-radius: 22rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
}

.button::after {
  display: none;
}

.button--primary {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
}

.button--secondary {
  width: auto;
  align-self: flex-start;
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  color: #2563eb;
  border: 1rpx solid #2563eb;
  background: transparent;
}

.link-button {
  padding: 0;
  font-size: 24rpx;
  color: #2563eb;
  background: transparent;
  border: none;
  height: auto;
  line-height: 1.4;
  display: inline-flex;
  align-items: center;
}

.link-button::after {
  display: none;
}

.secondary {
  align-self: flex-start;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  color: #0b6bcb;
  border: 1rpx solid #0b6bcb;
  background: transparent;
}

.message {
  font-size: 24rpx;
  padding: 18rpx;
  border-radius: 16rpx;
}

.message--error {
  background: #fee2e2;
  color: #b91c1c;
}

.message--success {
  background: #dcfce7;
  color: #15803d;
}
