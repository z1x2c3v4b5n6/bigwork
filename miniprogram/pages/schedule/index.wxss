.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b1f33;
}

.section__subtitle {
  font-size: 26rpx;
  color: #4d5b73;
}

.schedule-list,
.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.schedule-card {
  border: 1rpx solid #d8e2f2;
  border-radius: 20rpx;
  padding: 24rpx;
  background: #f8fbff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.schedule-card__title {
  font-size: 28rpx;
  font-weight: 600;
}

.schedule-card__meta {
  font-size: 24rpx;
  color: #4d5b73;
}

.schedule-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(11, 107, 203, 0.12);
  color: #0b6bcb;
}

.input {
  width: 100%;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d8e2f2;
  box-sizing: border-box;
  font-size: 26rpx;
  background: #f8fbff;
}

.submit {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-radius: 20rpx;
}

.message {
  font-size: 24rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.message--error {
  background: #fee2e2;
  color: #b91c1c;
}

.message--success {
  background: #dcfce7;
  color: #15803d;
}

.empty {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}
