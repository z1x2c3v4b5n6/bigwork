<view class="page">
  <view class="section">
    <view class="section__title">学习日程</view>
    <view class="section__subtitle">同步直播课、自习与模拟考试的时间安排。</view>

    <view class="message message--error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <view class="message" wx:if="{{loading}}">数据加载中，请稍候…</view>

    <block wx:if="{{schedule.length}}">
      <view class="schedule-list">
        <block wx:for="{{schedule}}" wx:key="id">
          <view class="schedule-card">
            <view class="schedule-card__title">{{item.title}}</view>
            <view class="schedule-card__meta">{{item.type}} · {{item.start}} → {{item.end}}</view>
            <view class="schedule-card__meta" wx:if="{{item.location}}">地点：{{item.location}}</view>
            <view class="schedule-card__meta" wx:if="{{item.focus}}">重点：{{item.focus}}</view>
      <view class="schedule-card__tags" wx:if="{{item.tags.length}}">
        <block wx:for="{{item.tags}}" wx:key="*this">
          <text class="tag">{{item}}</text>
        </block>
      </view>
          </view>
        </block>
      </view>
    </block>
    <block wx:else>
      <view class="empty">暂无日程，欢迎下方创建。</view>
    </block>
  </view>

  <view class="section">
    <view class="section__title">新增安排</view>
    <view class="form">
      <input class="input" placeholder="日程标题" value="{{form.title}}" data-field="title" bindinput="handleInput" />
      <input class="input" placeholder="类型（直播课/自习/模拟考试等）" value="{{form.type}}" data-field="type" bindinput="handleInput" />
      <picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="handleDateChange">
        <view class="picker">开始日期：{{form.startDate}}</view>
      </picker>
      <picker mode="time" value="{{form.startTime}}" data-field="startTime" bindchange="handleTimeChange">
        <view class="picker">开始时间：{{form.startTime}}</view>
      </picker>
      <picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="handleDateChange">
        <view class="picker">结束日期：{{form.endDate}}</view>
      </picker>
      <picker mode="time" value="{{form.endTime}}" data-field="endTime" bindchange="handleTimeChange">
        <view class="picker">结束时间：{{form.endTime}}</view>
      </picker>
      <input class="input" placeholder="地点（可选）" value="{{form.location}}" data-field="location" bindinput="handleInput" />
      <input class="input" placeholder="重点（可选）" value="{{form.focus}}" data-field="focus" bindinput="handleInput" />
      <input class="input" placeholder="标签（逗号分隔）" value="{{form.tags}}" data-field="tags" bindinput="handleInput" />
      <button class="submit" bindtap="createSchedule" loading="{{submitting}}" disabled="{{submitting}}">保存日程</button>
      <view class="message message--error" wx:if="{{!loading && errorMessage}}">{{errorMessage}}</view>
      <view class="message message--success" wx:if="{{successMessage}}">{{successMessage}}</view>
    </view>
  </view>
</view>
