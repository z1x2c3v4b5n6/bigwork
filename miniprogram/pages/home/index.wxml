<view class="page">
  <view class="hero">
    <view class="hero__title">你好，{{snapshot.userName}}</view>
    <view class="hero__subtitle">以下是你本周的学习进度与推荐动作。</view>
    <view class="hero__quick-nav">
      <button class="hero__btn" size="mini" data-page="advisor" bindtap="navigateToPage">院校推荐</button>
      <button class="hero__btn" size="mini" data-page="analytics" bindtap="navigateToPage">学习分析</button>
      <button class="hero__btn" size="mini" data-page="forum" bindtap="navigateToPage">考研论坛</button>
      <button class="hero__btn" size="mini" data-page="admin" bindtap="navigateToPage">后台管理</button>
      <button class="hero__btn hero__btn--accent" size="mini" data-page="checkin" bindtap="navigateToPage">今日打卡</button>
      <button class="hero__btn hero__btn--accent" size="mini" data-page="ai" bindtap="navigateToPage">AI 助手</button>
    </view>
  </view>

  <view class="message message--error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
  <view class="message" wx:if="{{loading}}">数据加载中，请稍候…</view>

  <view class="section section--toolkit">
    <view class="section__title">掌上学习工具</view>
    <view class="tool-grid">
      <view class="tool-card" data-page="checkin" bindtap="navigateToPage">
        <view class="tool-card__icon">📆</view>
        <view class="tool-card__title">学习打卡</view>
        <view class="tool-card__desc">查看今日任务与连续天数，生成学习卡片。</view>
      </view>
      <view class="tool-card" data-page="leaderboard" bindtap="navigateToPage">
        <view class="tool-card__icon">🏆</view>
        <view class="tool-card__title">进度排行榜</view>
        <view class="tool-card__desc">对比 TOP 学员与同校进度，激发学习动力。</view>
      </view>
      <view class="tool-card" data-page="wrongbook" bindtap="navigateToPage">
        <view class="tool-card__icon">📚</view>
        <view class="tool-card__title">离线错题本</view>
        <view class="tool-card__desc">本地缓存错题，离线也能复习，联网后自动同步。</view>
      </view>
      <view class="tool-card" data-page="ai" bindtap="navigateToPage">
        <view class="tool-card__icon">🤖</view>
        <view class="tool-card__title">AI 助手</view>
        <view class="tool-card__desc">提问英语作文、算法难题，获取即时解答。</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section__title">关键指标</view>
    <view class="stats-grid">
      <block wx:for="{{snapshot.stats}}" wx:key="id">
        <view class="stat-card">
          <view class="stat-card__value">{{item.value}}</view>
          <view class="stat-card__title">{{item.title}}</view>
          <view class="stat-card__helper">{{item.helperText}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section__title">课程进度</view>
    <block wx:if="{{snapshot.courses.length}}">
      <view class="card-list">
        <block wx:for="{{snapshot.courses}}" wx:key="id">
          <view class="course-card">
            <view class="course-card__header">
              <text class="course-card__title">{{item.title}}</text>
              <text class="course-card__category">{{item.category}}</text>
            </view>
            <view class="course-card__teacher">讲师：{{item.teacher}}</view>
            <view class="course-card__progress">当前进度：{{item.progress}}%</view>
            <view class="course-card__task">下一步：{{item.nextTask}}</view>
          </view>
        </block>
      </view>
    </block>
    <block wx:else>
      <view class="empty">暂无课程，请前往课程页新增。</view>
    </block>
  </view>

  <view class="section">
    <view class="section__title">刷题训练营</view>
    <block wx:if="{{snapshot.practiceSets.length}}">
      <view class="card-list">
        <block wx:for="{{snapshot.practiceSets}}" wx:key="id">
          <view class="practice-card">
            <view class="practice-card__title">{{item.name}}</view>
            <view class="practice-card__meta">{{item.questions}} 题 · 正确率 {{item.accuracyText}}</view>
            <view class="practice-card__focus">重点：{{item.focusText}}</view>
          </view>
        </block>
      </view>
    </block>
    <block wx:else>
      <view class="empty">暂无题单，请前往刷题页创建。</view>
    </block>
  </view>

  <view class="section">
    <view class="section__title">近期安排</view>
    <block wx:if="{{snapshot.schedule.length}}">
      <view class="schedule-list">
        <block wx:for="{{snapshot.schedule}}" wx:key="id">
          <view class="schedule-item">
            <view class="schedule-item__title">{{item.title}}</view>
            <view class="schedule-item__meta">{{item.type}} · {{item.start}} → {{item.end}}</view>
            <view class="schedule-item__meta" wx:if="{{item.location}}">地点：{{item.location}}</view>
            <view class="schedule-item__meta" wx:if="{{item.focus}}">重点：{{item.focus}}</view>
            <view class="schedule-item__tags" wx:if="{{item.tags.length}}">
              <block wx:for="{{item.tags}}" wx:key="index">
                <text class="tag">{{item}}</text>
              </block>
            </view>
          </view>
        </block>
      </view>
    </block>
    <block wx:else>
      <view class="empty">暂无安排，欢迎在日程页添加。</view>
    </block>
  </view>

  <view class="section">
    <view class="section__title">系统建议</view>
    <view class="recommendation">{{snapshot.recommendation}}</view>
  </view>
</view>
