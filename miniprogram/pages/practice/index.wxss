.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section__toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.section__toolbar-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b1f33;
}

.section__subtitle {
  font-size: 26rpx;
  color: #4d5b73;
}

.set-list,
.question-list,
.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.set-card {
  border: 1rpx solid #d8e2f2;
  border-radius: 20rpx;
  padding: 24rpx;
  background: #f8fbff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.set-card--active {
  border-color: #0b6bcb;
  box-shadow: 0 12rpx 24rpx rgba(11, 107, 203, 0.18);
}

.set-card__title {
  font-size: 28rpx;
  font-weight: 600;
}

.set-card__meta {
  font-size: 24rpx;
  color: #4d5b73;
}

.set-card__tags,
.question-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.question-card {
  border-radius: 20rpx;
  border: 1rpx solid #dbe3f2;
  padding: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.question-card__title {
  font-size: 28rpx;
  font-weight: 600;
}

.question-card__answer,
.question-card__explanation {
  font-size: 24rpx;
  color: #4d5b73;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(11, 107, 203, 0.12);
  color: #0b6bcb;
}

.tag--outline {
  background: transparent;
  border: 1rpx solid rgba(11, 107, 203, 0.45);
}

.input,
.textarea {
  width: 100%;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d8e2f2;
  box-sizing: border-box;
  font-size: 26rpx;
  background: #f8fbff;
}

.textarea {
  min-height: 140rpx;
}

.form__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.submit {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-radius: 20rpx;
}

.action-button {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.secondary-button {
  background: #e2e8f0;
  color: #1e293b;
  border-radius: 20rpx;
}

.message {
  font-size: 24rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.message--error {
  background: #fee2e2;
  color: #b91c1c;
}

.message--success {
  background: #dcfce7;
  color: #15803d;
}

.empty {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}
