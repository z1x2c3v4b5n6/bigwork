<view class="page">
  <view class="section">
    <view class="section__title">课程体系</view>
    <view class="section__subtitle">按照专业与科目偏好整理的课程列表，自动匹配适合的冲刺班与专项课。</view>

    <view class="message message--error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <view class="message" wx:if="{{loading}}">数据加载中，请稍候…</view>

    <block wx:if="{{courses.length}}">
      <view class="course-list">
        <block wx:for="{{courses}}" wx:key="id">
          <view class="course-card">
            <view class="course-card__header">
              <view class="course-card__title">{{item.title}}</view>
              <view class="course-card__meta">{{item.category}} · 讲师：{{item.teacher}}</view>
            </view>
            <view class="chip-list">
              <view class="chip chip--primary">{{item.category}}</view>
              <view wx:if="{{item.intensity}}" class="chip chip--accent">{{item.intensity}}</view>
            </view>
            <view wx:if="{{item.tags && item.tags.length}}" class="chip-list">
              <view wx:for="{{item.tags}}" wx:key="{{index}}" class="chip chip--outline">{{item}}</view>
            </view>
            <view wx:if="{{item.highlight}}" class="course-card__highlight">{{item.highlight}}</view>
            <view wx:if="{{item.suitability}}" class="suitability">
              <view wx:if="{{item.suitability.mathSubjects && item.suitability.mathSubjects.length}}" class="chip chip--info">
                数学：{{item.suitability.mathSubjects.join(' / ')}}
              </view>
              <view wx:if="{{item.suitability.englishSubjects && item.suitability.englishSubjects.length}}" class="chip chip--info">
                英语：{{item.suitability.englishSubjects.join(' / ')}}
              </view>
              <view wx:if="{{item.suitability.majors && item.suitability.majors.length}}" class="chip chip--success">
                专业：{{item.suitability.majors.join('、')}}
              </view>
            </view>
            <view class="course-card__progress">当前进度：{{item.progress}}%</view>
            <view class="course-card__task">下一步：{{item.nextTask}}</view>
          </view>
        </block>
      </view>
    </block>
    <block wx:else>
      <view class="empty">暂无课程，请先通过下方按钮新增或等待系统推荐。</view>
    </block>
  </view>

  <view class="section">
    <view class="section__title">精品小班（下周开班）</view>
    <view class="workshop-list">
      <block wx:for="{{workshops}}" wx:key="id">
        <view class="workshop-card">
          <view class="workshop-card__title">{{item.title}}</view>
          <view class="workshop-card__description">{{item.description}}</view>
          <view class="workshop-card__highlight">{{item.highlight}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section__toolbar">
      <view class="section__toolbar-info">
        <view class="section__title">课程录入</view>
        <view class="section__subtitle">选择适用专业与科目后保存，系统会自动过滤不适合的课程。</view>
      </view>
      <button class="action-button" bindtap="toggleFormVisibility">
        {{formVisible ? '收起表单' : '新增课程'}}
      </button>
    </view>

    <view class="form" wx:if="{{formVisible}}">
      <input class="input" placeholder="课程名称" value="{{form.title}}" data-field="title" bindinput="handleInput" />
      <input class="input" placeholder="讲师" value="{{form.teacher}}" data-field="teacher" bindinput="handleInput" />
      <input class="input" placeholder="课程类型（公共课/专业课）" value="{{form.category}}" data-field="category" bindinput="handleInput" />

      <picker mode="selector" range="{{majors}}" range-key="name" bindchange="handleMajorChange">
        <view class="picker">所属专业：{{selectedMajorName}}</view>
      </picker>

      <input class="input" type="number" placeholder="当前进度（0-100）" value="{{form.progress}}" data-field="progress" bindinput="handleInput" />
      <input class="input" placeholder="下一步任务" value="{{form.nextTask}}" data-field="nextTask" bindinput="handleInput" />

      <textarea
        class="textarea"
        placeholder="课程标签（逗号分隔，如：英语二, 复试口语）"
        value="{{form.tagsInput}}"
        data-field="tagsInput"
        bindinput="handleInput"
      ></textarea>

      <view class="form-field">
        <view class="form-field__label">适用数学科目</view>
        <checkbox-group class="checkbox-group" data-field="mathSubjects" bindchange="handleCheckboxChange">
          <label wx:for="{{mathSubjectOptions}}" wx:key="{{index}}" class="checkbox-item">
            <checkbox value="{{item}}" checked="{{form.mathSubjects.includes(item)}}" />
            <text>{{item}}</text>
          </label>
        </checkbox-group>
        <view class="form-field__helper">不选择表示对所有数学科目开放。</view>
      </view>

      <view class="form-field">
        <view class="form-field__label">适用英语科目</view>
        <checkbox-group class="checkbox-group" data-field="englishSubjects" bindchange="handleCheckboxChange">
          <label wx:for="{{englishSubjectOptions}}" wx:key="{{index}}" class="checkbox-item">
            <checkbox value="{{item}}" checked="{{form.englishSubjects.includes(item)}}" />
            <text>{{item}}</text>
          </label>
        </checkbox-group>
        <view class="form-field__helper">不选择表示对所有英语类别开放。</view>
      </view>

      <view class="form-field">
        <view class="form-field__label">可见专业</view>
        <checkbox-group class="checkbox-group" data-field="visibleMajorIds" bindchange="handleCheckboxChange">
          <label wx:for="{{majors}}" wx:key="id" class="checkbox-item">
            <checkbox value="{{item.id}}" checked="{{form.visibleMajorIds.includes(item.id)}}" />
            <text>{{item.name}}</text>
          </label>
          <label class="checkbox-item">
            <checkbox value="__other__" checked="{{form.visibleMajorIds.includes('__other__')}}" />
            <text>其他专业</text>
          </label>
        </checkbox-group>
        <view class="form-field__helper">不选择表示适合所有专业，可勾选“其他专业”覆盖跨考人群。</view>
      </view>

      <textarea class="textarea" placeholder="备注（可选）" value="{{form.description}}" data-field="description" bindinput="handleInput"></textarea>

      <view class="form__actions">
        <button class="submit" bindtap="submitCourse" loading="{{submitting}}" disabled="{{submitting}}">保存课程</button>
        <button class="secondary-button" bindtap="cancelForm" type="default" disabled="{{submitting}}">取消</button>
      </view>
    </view>

    <view class="message message--error" wx:if="{{formErrorMessage}}">{{formErrorMessage}}</view>
    <view class="message message--success" wx:if="{{successMessage}}">{{successMessage}}</view>
  </view>
</view>
