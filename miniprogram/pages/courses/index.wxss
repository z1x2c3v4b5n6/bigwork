.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section__toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.section__toolbar-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b1f33;
}

.section__subtitle {
  font-size: 26rpx;
  color: #4d5b73;
}

.course-list,
.workshop-list,
.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.course-card {
  border: 1rpx solid #d8e2f2;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #f8fbff;
}

.course-card__header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.course-card__title {
  font-size: 28rpx;
  font-weight: 600;
}

.course-card__meta,
.course-card__progress,
.course-card__task {
  font-size: 24rpx;
  color: #4d5b73;
}

.course-card__highlight {
  font-size: 24rpx;
  color: #0b1f33;
  background: #e8f1ff;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  border: 1rpx solid transparent;
}

.chip--primary {
  background: #e8f1ff;
  color: #0b6bcb;
  border-color: #c6dcff;
}

.chip--accent {
  background: #fff4e5;
  color: #c65f00;
  border-color: #ffd6a0;
}

.chip--outline {
  background: #ffffff;
  color: #1e293b;
  border-color: #cbd5f5;
}

.chip--info {
  background: #f1f5ff;
  color: #0b53c9;
  border-color: #c7d5ff;
}

.chip--success {
  background: #ecfdf5;
  color: #047857;
  border-color: #bbf7d0;
}

.suitability {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.workshop-card {
  border-radius: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #e0edff, #f1f5ff);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.workshop-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0b1f33;
}

.workshop-card__description {
  font-size: 24rpx;
  color: #4d5b73;
}

.workshop-card__highlight {
  font-size: 24rpx;
  color: #0b6bcb;
  font-weight: 600;
}

.input,
.textarea,
.picker {
  width: 100%;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d8e2f2;
  box-sizing: border-box;
  font-size: 26rpx;
  background: #f8fbff;
}

.textarea {
  min-height: 160rpx;
}

.submit {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-radius: 20rpx;
}

.action-button {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-field__label {
  font-size: 24rpx;
  color: #0b1f33;
  font-weight: 600;
}

.form-field__helper {
  font-size: 22rpx;
  color: #64748b;
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #1e293b;
}

.form__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 12rpx;
}

.secondary-button {
  background: #e2e8f0;
  color: #1e293b;
  border-radius: 20rpx;
}

.message {
  font-size: 24rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.message--error {
  background: #fee2e2;
  color: #b91c1c;
}

.message--success {
  background: #dcfce7;
  color: #15803d;
}

.empty {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}
