<view class="advisor-page">
  <scroll-view class="advisor-scroll" scroll-y>
    <view class="form-card">
      <view class="form-group">
        <text class="group-label">初试总分</text>
        <input
          class="group-input"
          type="number"
          placeholder="请输入初试总分"
          value="{{scoreInput}}"
          bindinput="onScoreInput"
        />
      </view>
      <view class="form-group">
        <text class="group-label">目标专业（可选）</text>
        <input
          class="group-input"
          placeholder="如 计算机、金融等"
          value="{{majorInput}}"
          bindinput="onMajorInput"
        />
      </view>
      <view class="form-row">
        <view class="form-column">
          <text class="group-label">数学科目</text>
          <picker mode="selector" range="{{mathOptions}}" value="{{mathIndex}}" bindchange="onMathChange">
            <view class="picker">{{mathOptions[mathIndex]}}</view>
          </picker>
        </view>
        <view class="form-column">
          <text class="group-label">英语科目</text>
          <picker mode="selector" range="{{englishOptions}}" value="{{englishIndex}}" bindchange="onEnglishChange">
            <view class="picker">{{englishOptions[englishIndex]}}</view>
          </picker>
        </view>
      </view>
      <button class="primary-button" bindtap="onGenerate" loading="{{loading}}" disabled="{{loading}}">
        {{loading ? '智能分析中…' : '生成推荐'}}
      </button>
      <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>
    </view>

    <view wx:if="{{recommendation}}" class="result-section">
      <view class="card highlight-card">
        <view class="card-title">{{recommendation.scoreBand}}</view>
        <view class="card-desc">{{recommendation.summary}}</view>
        <view class="badge-row">
          <view class="badge primary">总分：{{recommendation.totalScore}}</view>
          <view wx:if="{{focusPreview.length}}" class="badge success">
            复试重点：{{focusPreview.join('、')}}
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-title">推荐院校组合</view>
        <block wx:for="{{recommendation.recommendedUniversities}}" wx:key="id" wx:for-item="item">
          <view class="card university-card">
            <view class="uni-header">
              <view>
                <view class="uni-name">{{item.name}}</view>
                <view class="uni-meta">{{item.province}} · {{item.level}} · {{item.category}}</view>
              </view>
              <view class="status-badge status-{{item.matchLevel}}">{{item.matchLevel}}</view>
            </view>
            <view class="chip-list">
              <view class="chip">{{item.scoreWindow}}</view>
              <view class="chip" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="tag">{{tag}}</view>
            </view>
            <view
              wx:if="{{item.examSubjects.math || item.examSubjects.english || item.examSubjects.politics || item.examSubjects.professional}}"
              class="chip-list"
            >
              <view wx:if="{{item.examSubjects.math}}" class="chip accent">数学：{{item.examSubjects.math}}</view>
              <view wx:if="{{item.examSubjects.english}}" class="chip accent">英语：{{item.examSubjects.english}}</view>
              <view wx:if="{{item.examSubjects.politics}}" class="chip accent">政治：{{item.examSubjects.politics}}</view>
              <view wx:if="{{item.examSubjects.professional}}" class="chip accent">专业课：{{item.examSubjects.professional}}</view>
            </view>
            <view class="card-desc">{{item.highlights}}</view>
            <view class="alert info">{{item.matchReason}}</view>
            <view class="alert {{item.subjectMatch ? 'success' : 'warning'}}">{{item.subjectAdvice}}</view>
            <view wx:if="{{item.interviewFocus.length}}" class="chip-list wrap">
              <view class="chip focus" wx:for="{{item.interviewFocus}}" wx:for-item="topic" wx:key="topic">复试：{{topic}}</view>
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{recommendation.strategy.length}}" class="section">
        <view class="section-title">备考策略</view>
        <view class="bullet" wx:for="{{recommendation.strategy}}" wx:for-item="tip" wx:key="index">{{tip}}</view>
      </view>

      <view class="divider"></view>

      <view class="section">
        <view class="section-title">复试准备路线图</view>
        <block wx:for="{{recommendation.interviewPreparation.timeline}}" wx:key="stage" wx:for-item="step">
          <view class="card timeline-card">
            <view class="timeline-stage">{{step.stage}}</view>
            <view class="bullet" wx:for="{{step.items}}" wx:for-item="task" wx:key="task">{{task}}</view>
          </view>
        </block>
      </view>

      <view wx:if="{{recommendation.interviewPreparation.resources.length}}" class="section">
        <view class="section-title">工具与资料</view>
        <block wx:for="{{recommendation.interviewPreparation.resources}}" wx:key="name" wx:for-item="resource">
          <view class="card resource-card">
            <view class="resource-name">{{resource.name}}</view>
            <view class="card-desc">{{resource.description}}</view>
            <view class="link">{{resource.url}}</view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>
</view>
