.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b1f33;
}

.section__subtitle {
  font-size: 26rpx;
  color: #4d5b73;
}

.topic-list,
.reply-list,
.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.topic-card {
  border: 1rpx solid #d8e2f2;
  border-radius: 20rpx;
  padding: 24rpx;
  background: #f8fbff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.topic-card--active {
  border-color: #0b6bcb;
  box-shadow: 0 12rpx 24rpx rgba(11, 107, 203, 0.18);
}

.topic-card__title {
  font-size: 28rpx;
  font-weight: 600;
}

.topic-card__description,
.topic-card__meta {
  font-size: 24rpx;
  color: #4d5b73;
}

.topic-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(11, 107, 203, 0.12);
  color: #0b6bcb;
}

.topic-detail {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background: #f8fbff;
  padding: 20rpx;
  border-radius: 20rpx;
}

.topic-detail__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0b1f33;
}

.topic-detail__meta {
  font-size: 22rpx;
  color: #94a3b8;
}

.topic-detail__description {
  font-size: 24rpx;
  color: #4d5b73;
  line-height: 1.5;
}

.action-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-bar__btn {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-radius: 20rpx;
}

.action-bar__info {
  font-size: 24rpx;
  color: #4d5b73;
}

.reply-card {
  border-radius: 20rpx;
  border: 1rpx solid #dbe3f2;
  padding: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reply-card__author {
  font-size: 26rpx;
  font-weight: 600;
  color: #0b1f33;
}

.reply-card__content {
  font-size: 24rpx;
  color: #4d5b73;
}

.reply-card__time {
  font-size: 22rpx;
  color: #94a3b8;
}

.input,
.textarea {
  width: 100%;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d8e2f2;
  box-sizing: border-box;
  font-size: 26rpx;
  background: #f8fbff;
}

.textarea {
  min-height: 140rpx;
}

.submit {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-radius: 20rpx;
}

.message {
  font-size: 24rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.message--error {
  background: #fee2e2;
  color: #b91c1c;
}

.message--success {
  background: #dcfce7;
  color: #15803d;
}

.empty {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}
