<view class="page">
  <scroll-view class="scroll" scroll-y>
    <view class="card" wx:for="{{scoreBandGuides}}" wx:key="band" wx:for-item="guide">
      <view class="card-title">{{guide.band}} 分段策略</view>
      <view class="card-desc">{{guide.summary}}</view>
      <view class="section-title">行动建议</view>
      <view class="bullet">{{guide.action}}</view>
    </view>

    <view class="card" wx:for="{{templates}}" wx:key="id" wx:for-item="template">
      <view class="card-title">{{template.title}}</view>
      <view class="card-desc">{{template.description}}</view>

      <view class="section-title">推荐结构</view>
      <view class="bullet" wx:for="{{template.structure}}" wx:key="index" wx:for-item="section">
        {{section}}
      </view>

      <view class="section-title">表达亮点</view>
      <view class="bullet" wx:for="{{template.highlights}}" wx:key="index" wx:for-item="highlight">
        {{highlight}}
      </view>

      <view class="section-title">准备清单</view>
      <view class="bullet" wx:for="{{template.checklist}}" wx:key="index" wx:for-item="task">
        {{task}}
      </view>
    </view>
  </scroll-view>
</view>
