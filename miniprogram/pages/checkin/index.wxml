<view class="page">
  <view wx:if="{{sessionRequired}}" class="login-placeholder">
    <view class="login-placeholder__title">请先登录后再打卡</view>
    <view class="login-placeholder__desc">进入“我的”页完成账号密码登录，即可解锁每日学习任务并记录连续天数。</view>
    <button class="login-placeholder__btn" type="primary" bindtap="handleGoLogin">前往登录</button>
  </view>
  <block wx:else>
    <view class="header-card">
      <view class="header-card__badge">连续打卡</view>
      <view class="header-card__streak">{{status.streak}} 天</view>
      <view class="header-card__desc">坚持完成每日任务，积累备考动力。</view>
      <view class="header-card__status" wx:if="{{status.completedToday}}">
        <text class="header-card__status-icon">✅</text>
        <text>今日已完成</text>
      </view>
      <view class="header-card__status header-card__status--pending" wx:else>
        <text class="header-card__status-icon">⚡️</text>
        <text>还有任务等待完成</text>
      </view>
    </view>

    <view class="task-card">
      <view class="task-card__meta">今日任务</view>
      <view class="task-card__title">{{status.task.title}}</view>
      <view class="task-card__target">目标：{{status.task.targetText}}</view>
      <view class="task-card__description">{{status.task.description}}</view>
      <view class="task-card__footer">
        <view class="task-card__duration">预估用时 {{status.task.estimatedMinutes}} 分钟</view>
        <button
          class="task-card__btn"
          type="primary"
          loading="{{completing}}"
          disabled="{{sessionRequired || status.completedToday}}"
          bindtap="completeTask"
        >
          {{status.completedToday ? '今日已完成' : '完成打卡'}}
        </button>
      </view>
    </view>

    <view class="section">
      <view class="section__title">学习纪念卡片</view>
      <view class="section__actions">
        <button class="section__btn" loading="{{generatingPoster}}" bindtap="sharePoster">生成分享图</button>
        <button class="section__btn section__btn--outline" bindtap="handleRefreshTap" data-force="true">刷新任务</button>
      </view>
      <canvas
        type="2d"
        id="daily-share-canvas"
        class="share-canvas"
        style="width: 600rpx; height: 720rpx;"
      ></canvas>
      <image
        wx:if="{{posterTempPath}}"
        class="share-preview"
        mode="aspectFill"
        src="{{posterTempPath}}"
      />
    </view>
  </block>

  <view class="message message--error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
</view>
