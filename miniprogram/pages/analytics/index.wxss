.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b1f33;
}

.section__subtitle {
  font-size: 26rpx;
  color: #4d5b73;
}

.highlight-list,
.subject-list,
.knowledge-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.highlight-card,
.subject-card,
.knowledge-card {
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #d8e2f2;
  background: #f8fbff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.highlight-card__title,
.subject-card__title,
.knowledge-card__topic {
  font-size: 28rpx;
  font-weight: 600;
  color: #0b1f33;
}

.highlight-card__description,
.subject-card__mastery,
.subject-card__focus,
.knowledge-card__meta,
.knowledge-card__action {
  font-size: 24rpx;
  color: #4d5b73;
}
