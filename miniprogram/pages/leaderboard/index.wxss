.page {
  min-height: 100vh;
  background: #0f172a;
  color: #f8fafc;
  padding: 32rpx 28rpx 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.header__title {
  font-size: 40rpx;
  font-weight: 700;
}

.header__subtitle {
  font-size: 26rpx;
  color: rgba(148, 163, 184, 0.9);
}

.tabs {
  display: flex;
  gap: 16rpx;
  background: rgba(30, 41, 59, 0.72);
  padding: 12rpx;
  border-radius: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: rgba(148, 163, 184, 0.85);
}

.tab--active {
  background: linear-gradient(135deg, #0ea5e9, #22d3ee);
  color: #0f172a;
  font-weight: 600;
}

.message {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(148, 163, 184, 0.1);
  font-size: 24rpx;
}

.message--error {
  background: rgba(248, 113, 113, 0.12);
  color: #fecaca;
}

.leaderboard {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(30, 41, 59, 0.82);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(94, 234, 212, 0.16);
}

.entry__rank {
  font-size: 36rpx;
  font-weight: 700;
  width: 96rpx;
  text-align: center;
  color: #facc15;
}

.entry__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.entry__name {
  font-size: 30rpx;
  font-weight: 600;
}

.entry__meta {
  font-size: 24rpx;
  color: rgba(148, 163, 184, 0.9);
}

.entry__stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.entry__progress {
  font-size: 26rpx;
  color: #38bdf8;
}

.entry__hours {
  font-size: 24rpx;
  color: rgba(148, 163, 184, 0.85);
}
