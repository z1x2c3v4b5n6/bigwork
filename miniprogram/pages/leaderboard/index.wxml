<view class="page">
  <view class="header">
    <view class="header__title">掌上学习排行榜</view>
    <view class="header__subtitle">实时了解同伴进度，激励自己冲刺目标。</view>
  </view>

  <view class="tabs">
    <view
      class="tab {{scope === 'global' ? 'tab--active' : ''}}"
      data-scope="global"
      bindtap="handleScopeChange"
    >TOP 学员榜</view>
    <view
      class="tab {{scope === 'campus' ? 'tab--active' : ''}}"
      data-scope="campus"
      bindtap="handleScopeChange"
    >同院校进度榜</view>
  </view>

  <view class="message" wx:if="{{loading}}">排行榜同步中，请稍候…</view>
  <view class="message message--error" wx:if="{{errorMessage}}">{{errorMessage}}</view>

  <view class="leaderboard" wx:if="{{!loading}}">
    <block wx:for="{{entries}}" wx:key="id">
      <view class="entry">
        <view class="entry__rank">#{{item.rank}}</view>
        <view class="entry__info">
          <view class="entry__name">{{item.name}}</view>
          <view class="entry__meta">{{item.university}}</view>
        </view>
        <view class="entry__stats">
          <view class="entry__progress">进度 {{item.progress}}%</view>
          <view class="entry__hours">累计 {{item.hours}} 小时</view>
        </view>
      </view>
    </block>
  </view>
</view>
