.admin-page {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.admin-tabs {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.admin-tabs__item {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4d5b73;
  border: 1rpx solid #d8e2f2;
  font-size: 26rpx;
}

.admin-tabs__item.is-active {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-color: transparent;
}

.alert {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.alert--error {
  background: #fee2e2;
  color: #b91c1c;
  border: 1rpx solid #fecaca;
}

.panel,
.panel-group {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.panel--loading,
.panel--error {
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 200rpx;
  font-size: 26rpx;
  color: #4d5b73;
}

.panel--error {
  color: #b91c1c;
}

.panel-group .section {
  background: #f8fbff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border: 1rpx solid #dbe5f4;
}

.section__header,
.section__toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.section__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0b1f33;
}

.section__subtitle {
  font-size: 24rpx;
  color: #4d5b73;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200rpx, 1fr));
  gap: 20rpx;
}

.metric-grid--statistics {
  grid-template-columns: repeat(auto-fill, minmax(220rpx, 1fr));
}

.metric-card {
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid #d8e2f2;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-start;
}

.metric-card__value {
  font-size: 34rpx;
  font-weight: 700;
  color: #0b6bcb;
}

.metric-card__label {
  font-size: 24rpx;
  color: #4d5b73;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid #d8e2f2;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.list-item--topic.is-active {
  border-color: #0b6bcb;
  background: #f0f7ff;
}

.list-item__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0b1f33;
}

.list-item__subtitle,
.list-item__meta,
.list-item__description {
  font-size: 24rpx;
  color: #4d5b73;
}

.list-item__description {
  line-height: 1.6;
}

.list-item__actions {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.table {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.table-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid #d8e2f2;
  padding: 20rpx;
}

.table-cell {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.table-cell--grow {
  flex: 1;
}

.table-title {
  font-size: 28rpx;
  font-weight: 600;
}

.table-subtitle {
  font-size: 24rpx;
  color: #4d5b73;
}

.table-cell--role {
  min-width: 160rpx;
}

.table-cell--actions {
  display: flex;
  gap: 12rpx;
}

.picker-value {
  padding: 16rpx 20rpx;
  background: #f0f7ff;
  border-radius: 14rpx;
  border: 1rpx solid #c6daf7;
  font-size: 24rpx;
  color: #0b1f33;
}

.primary-button {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
  border-radius: 999rpx;
  border: none;
  padding: 16rpx 32rpx;
}

.empty {
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 18rpx;
  font-size: 24rpx;
  color: #667894;
  text-align: center;
}

.note {
  font-size: 24rpx;
  color: #4d5b73;
  background: #eef4ff;
  padding: 20rpx;
  border-radius: 16rpx;
}

.site-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260rpx, 1fr));
  gap: 20rpx;
}

.site-card {
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid #d8e2f2;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.site-card__title {
  font-size: 26rpx;
  font-weight: 600;
}

.site-card__description {
  font-size: 24rpx;
  color: #4d5b73;
}

.site-card__actions {
  display: flex;
  gap: 12rpx;
}

.dialog {
  position: fixed;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 99;
}

.dialog__mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
}

.dialog__panel {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  width: 80%;
  max-width: 640rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: 0 24rpx 48rpx rgba(15, 23, 42, 0.18);
}

.dialog__title {
  font-size: 32rpx;
  font-weight: 600;
}

.dialog__body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dialog__footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.dialog__btn {
  padding: 16rpx 24rpx;
  border-radius: 14rpx;
  background: #e2e8f0;
  color: #1e293b;
  border: none;
  font-size: 26rpx;
}

.dialog__btn--primary {
  background: linear-gradient(135deg, #0b6bcb, #3f8cff);
  color: #ffffff;
}

.form-field {  
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300rpx, 1fr));
  gap: 20rpx;
}

.form-field--full {
  grid-column: 1 / -1;
}

.form-field__label {
  font-size: 24rpx;
  color: #4d5b73;
}

.form-field__input,
.form-field__textarea {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #c6daf7;
  background: #f8fbff;
  font-size: 26rpx;
}

.form-field__textarea {
  min-height: 180rpx;
  line-height: 1.6;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.form-message {
  font-size: 24rpx;
  padding: 16rpx;
  border-radius: 14rpx;
}

.form-message--error {
  background: #fee2e2;
  color: #b91c1c;
}

.form-message--success {
  background: #dcfce7;
  color: #15803d;
}

.panel--split {
  display: flex;
  gap: 24rpx;
  align-items: stretch;
}

.panel-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.panel-column--grow {
  flex: 2;
}

.secondary-button {
  background: #e2e8f0;
  color: #1e293b;
  border-radius: 999rpx;
  border: none;
  padding: 16rpx 32rpx;
}

.statistics-search {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.statistics-search__actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.statistics-result {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: #f8fbff;
  border: 1rpx solid #dbe5f4;
  border-radius: 20rpx;
  padding: 24rpx;
}

.statistics-result--placeholder {
  background: #eff6ff;
  border-style: dashed;
}

.statistics-result__group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.statistics-result__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #0b1f33;
}

.statistics-result__items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 24rpx;
  color: #4d5b73;
}

.statistics-result__items--empty {
  color: #94a3b8;
  font-style: italic;
}

.statistics-result__chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #e0edff;
  color: #0b3b8c;
}

.list--posts .list-item__title {
  white-space: pre-wrap;
}
