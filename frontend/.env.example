# Base URL of the backend service.
# Examples:
#   http://localhost:3000
#   https://api.my-kaoyan-platform.com
VITE_API_BASE_URL=http://localhost:3000

# Endpoint path that returns the dashboard overview payload.
# Default is /api/dashboard when not provided.
VITE_DASHBOARD_ENDPOINT=/api/dashboard

# Optional overrides for other API endpoints (defaults assume /api prefix).
VITE_SCHEDULE_ENDPOINT=/api/schedule
VITE_PRACTICE_ENDPOINT=/api/practice
VITE_ADMIN_OVERVIEW_ENDPOINT=/api/admin/overview
VITE_ADMIN_COURSES_ENDPOINT=/api/admin/courses
VITE_ADMIN_SYNC_ENDPOINT=/api/admin/sync

# Whether Axios should send cookies/credentials with each request.
VITE_API_WITH_CREDENTIALS=false
